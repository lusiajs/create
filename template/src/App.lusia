<script>
  import { variable } from "lusiajs";

  const count = variable(0);
</script>

<main>
  <h1>Hello Lusia</h1>
  <button onclick={() => count.value++}>Clicked {count.value} times</button>
</main>

<style>
  main {
    font-family: system-ui;
    padding: 2rem;
  }

  button {
    font-size: 1rem;
    padding: 0.5rem 1rem;
  }
</style>
